# Database Configuration
DB_USER=bankinguser
DB_PASSWORD=securepassword
DB_NAME=banking_ai_db

# Redis Configuration
REDIS_PASSWORD=redispass

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=change-me-in-production

# OAuth Configuration
OAUTH_PROVIDER=okta

# Azure OpenAI (for Conversation Engine)
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=

# Azure Speech (for Voice Bot)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Core Banking Integration
CORE_BANKING_API=http://core-banking:8080
CORE_BANKING_KEY=

# Twilio (for Voice Bot)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Grafana
GRAFANA_PASSWORD=admin

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
